# Required for production. For local dev, you can leave most blank.

# MapTiler API key (free tier at https://cloud.maptiler.com/account/keys/, no credit card)
NEXT_PUBLIC_MAPTILER_KEY=
MAPTILER_KEY=

# GitHub App credentials (for the contribution bot)
GH_APP_ID=
GH_APP_INSTALLATION_ID=
GH_APP_PRIVATE_KEY=
GH_REPO_OWNER=
GH_REPO_NAME=clt-app

# Upstash Redis (rate limit state)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Webhook secret for triggering revalidation on data updates
REVALIDATION_SECRET=

# NREL API key for EV-charging station imports (scripts/import-gis.ts)
# Sign up at https://developer.nlr.gov/signup — free, instant approval.
# Leave blank to use DEMO_KEY automatically (rate-limited: 30 req/hr, 50 req/day).
NREL_API_KEY=

# Sentry (optional)
SENTRY_DSN=
