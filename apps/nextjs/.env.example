# Required for production. For local dev, you can leave most blank.

# CDN for data bundles + tiles
R2_PUBLIC_BASE_URL=https://cdn.clt-app.com

# GitHub App credentials (for the contribution bot)
GH_APP_ID=
GH_APP_INSTALLATION_ID=
GH_APP_PRIVATE_KEY=
GH_REPO_OWNER=
GH_REPO_NAME=clt-app

# Upstash Redis (rate limit state)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Webhook secret for triggering revalidation on data updates
REVALIDATION_SECRET=

# Sentry (optional)
SENTRY_DSN=
